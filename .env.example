# Copy to .env.local and fill in what you need. Everything here is optional for
# local development — the app runs without any of it, it just runs quieter.
#
# Every variable is NEXT_PUBLIC_, which means Next.js inlines it into the browser
# bundle at build time. None of them is a secret, and none of them is read at
# request time: change one and you must restart `npm run dev`, or redeploy.

# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph, the
# sitemap and JSON-LD. Defaults to https://sunsetatlas.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mixpanel. Unset, analytics is silent — which is what you want locally.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Draws the world map on the home page. Unset, the home page renders the nation
# index and a note instead of the map; nothing else changes. See "Running the map
# locally" in README.md for how to get one.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
